# Copy to .env (gitignored) or export in your shell. None of these are required to build or test.
# Optional: raises the shadcn MCP server's GitHub rate limit from 60 to 5000/hour. No scopes needed.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional: enables the 21st.dev magic-mcp component generator. Key from https://21st.dev/mcp
API_KEY_21ST=
# Optional: Strix penetration testing. Requires Docker. Install: curl -sSL https://strix.ai/install | bash
STRIX_LLM=
LLM_API_KEY=
